{
  "name": "enpet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @enpet/server dev",
    "dev:web": "pnpm --filter @enpet/web dev",
    "build": "pnpm --filter @enpet/web build && pnpm --filter @enpet/server build",
    "start": "pnpm --filter @enpet/server start",
    "build:desktop": "pnpm --filter @enpet/web build && pnpm --filter @enpet/desktop build",
    "dev:desktop": "pnpm --filter @enpet/web build && pnpm --filter @enpet/desktop dev",
    "release": "pnpm build:desktop && pnpm --filter @enpet/desktop exec electron-builder --mac dmg --arm64 --x64 --publish never",
    "release:local": "pnpm build:desktop && pnpm --filter @enpet/desktop exec electron-builder --mac dmg --arm64 --publish never",
    "reset:local": "bash scripts/reset-local-data.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
